# --- Database ---------------------------------------------------------------
# Local: docker compose maps Postgres to host port 5436 (5432-5435 are often taken by other projects).
DATABASE_URL=postgresql://owlyn:owlyn@localhost:5436/owlyn?schema=public

# --- Auth.js ----------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Razorpay ---------------------------------------------------------------
# Test-mode key pair from the Razorpay dashboard. Without both, checkout offers cash on delivery only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret set on the dashboard webhook that points at /api/webhooks/razorpay
# (events: payment.captured, payment.failed, refund.processed). Unsigned deliveries are rejected.
RAZORPAY_WEBHOOK_SECRET=

# --- Email (Resend) ---------------------------------------------------------
# Without RESEND_API_KEY, rendered emails are written to .dev-outbox/ instead of sent.
RESEND_API_KEY=
EMAIL_FROM="Owlyn <orders@owlyn.example>"

# --- File storage -----------------------------------------------------------
UPLOADTHING_TOKEN=

# --- Cache / rate limiting (optional; in-memory fallback in dev) ------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Jobs ----------------------------------------------------------------
# Bearer token for /api/jobs/* (Vercel cron sends it automatically when set as CRON_SECRET)
CRON_SECRET=

# --- Local file storage (invoices) -----------------------------------------
# Invoice PDFs are written under this directory by lib/storage.ts (S3/UploadThing driver can replace it).
STORAGE_DIR=./storage

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Seed admin -------------------------------------------------------------
ADMIN_SEED_EMAIL=admin@owlyn.example
ADMIN_SEED_PASSWORD=
